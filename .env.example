# LLM — pick one. Mock works with no keys (extractive answers).
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# --- or Ollama (local, free) ---
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=llama3.1

TTS_PROVIDER=mock
# TTS_PROVIDER=edge

STORAGE_DIR=./data
LIMIT_SOURCES_PER_NOTEBOOK=50
LIMIT_WORDS_PER_SOURCE=500000
LIMIT_CHATS_PER_DAY=50
LIMIT_AUDIO_PER_DAY=3
LIMIT_STUDIO_PER_DAY=10
PORT=8000
EMBEDDINGS=auto
RERANK=auto
AUTH_REQUIRED=0
SESSION_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMBED_MODEL=all-MiniLM-L6-v2
